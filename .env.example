# Copy to .env.local after creating your Supabase project.
# Only use the publishable key (or legacy anon key), never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Email of the confirmed Supabase Auth demo user; maps username "test" to this email.
# This is public configuration. Do not put the account password here.
NEXT_PUBLIC_DEMO_EMAIL=ana.silkin04@gmail.com
